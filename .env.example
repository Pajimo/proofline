# Copy to .env (git-ignored) and fill in. Never commit .env.

# Meta Developer API (https://dev.meta.ai). Sent as "Authorization: Bearer ...".
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Baseten: Muse Spark Open (open weights)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Hackathon id. Baseten's public page lists meta-models/muse-spark-open.
BASETEN_MODEL=meta-models/muse-spark-open-1026

# WhatsApp Cloud API (free test number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# E.164 without "+", e.g. 447700900123. Must be a verified test recipient.
WHATSAPP_TEST_RECIPIENT=
