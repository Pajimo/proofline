# Copy to .env (git-ignored) and fill in. Never commit .env.

# Meta Developer API (https://dev.meta.ai). Sent as "Authorization: Bearer ...".
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Baseten: Muse Spark Open (open weights)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Public id. The hackathon id meta-models/muse-spark-open-1026 returned 404 on 27 Oct 2026.
BASETEN_MODEL=meta-models/muse-spark-open

# WhatsApp Cloud API (free test number = "Dave's Plumbing")
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings > Basic > App secret. Used to check X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into the app's webhook configuration.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
# E.164 without "+", e.g. 447700900123. Must be verified test recipients.
WHATSAPP_TEST_RECIPIENT=
# The tradesperson's own phone (gets approval requests). A second verified number.
WHATSAPP_OWNER_NUMBER=
