{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verified_line_item.schema.json",
  "title": "VerifiedLineItem",
  "description": "One invoice line, with proof: when it happened in the job video and the frames that show it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "description", "qty", "unit", "unit_price", "price", "currency", "t_start", "t_end", "evidence_frames", "evidence_status", "confidence", "source", "flags"],
  "properties": {
    "id": { "type": "string", "description": "Stable id within the job, e.g. L1." },
    "kind": { "enum": ["part", "labour", "callout", "other"] },
    "description": { "type": "string", "minLength": 1 },
    "pack_item_id": { "type": ["string", "null"], "description": "Matching id in the job pack's price list, or null if unpriced." },
    "qty": { "type": "number", "exclusiveMinimum": 0 },
    "unit": { "type": "string", "description": "each, kit, roll, hour, ..." },
    "unit_price": { "type": ["number", "null"], "minimum": 0, "description": "Null if not in the price list. Never taken from narration alone." },
    "price": { "type": ["number", "null"], "minimum": 0, "description": "qty * unit_price, rounded to 2 dp." },
    "currency": { "const": "GBP" },
    "t_start": { "type": "number", "minimum": 0, "description": "Seconds from the start of the job video." },
    "t_end": { "type": "number", "minimum": 0 },
    "evidence_frames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "role"],
        "properties": {
          "t": { "type": "number", "minimum": 0, "description": "Seconds from the start of the job video." },
          "frame_index": { "type": ["integer", "null"], "minimum": 0 },
          "role": { "enum": ["before", "during", "after"] },
          "image": { "type": ["string", "null"], "description": "Path or URL of the masked frame." },
          "box": {
            "type": ["array", "null"],
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x1, y1, x2, y2] in source pixels, from SAM 3.1."
          },
          "sam_prompt": { "type": ["string", "null"] }
        }
      }
    },
    "evidence_status": {
      "enum": ["verified", "narration_only", "visual_only", "missing"],
      "description": "verified = seen and said; missing = neither. Lines other than verified are flagged for review."
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "enum": ["video", "narration", "both", "manual"] },
    "transcript_quote": { "type": ["string", "null"], "description": "Narration turn that supports this line." },
    "flags": {
      "type": "array",
      "items": { "enum": ["no_evidence", "not_in_price_list", "price_spoken_aloud", "shown_not_used", "excluded_work", "edited_by_tradesperson", "low_confidence"] },
      "description": "Reasons a human must look at this line before sending."
    },
    "proof_url": { "type": ["string", "null"], "description": "Masked video link with a #t=start,end media fragment." }
  }
}
