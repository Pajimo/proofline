{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trade pack",
  "description": "One trade's faults, safety rules, prices and parts. See CONTRIBUTING.md.",
  "type": "object",
  "required": ["pack", "version", "currency", "labour", "trade", "safety", "faults", "parts"],
  "properties": {
    "pack": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "version": {"type": "integer"},
    "currency": {"type": "string", "enum": ["GBP"]},
    "labour": {"type": "object", "required": ["rate_per_hour"],
               "properties": {"rate_per_hour": {"type": "number", "minimum": 0}}},
    "trade": {
      "type": "object",
      "required": ["label", "business_name", "owner_name", "estimate_wording", "covers", "nothing_seen_question"],
      "properties": {
        "label": {"type": "string"},
        "estimate_wording": {"type": "string", "pattern": "(?i)subject to inspection"},
        "covers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "not_covered": {"type": "array", "items": {"type": "string"}}
      }
    },
    "excluded": {"type": "array", "items": {
      "type": "object", "required": ["id", "reason", "keywords"],
      "properties": {"keywords": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "safety": {"type": "array", "minItems": 3, "items": {
      "type": "object", "required": ["kind", "keywords", "message"],
      "properties": {
        "kind": {"type": "string", "enum": ["gas", "carbon_monoxide", "electrical"]},
        "keywords": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "message": {"type": "string", "minLength": 40}
      }}},
    "faults": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "name", "symptoms", "sam_prompts", "follow_up_questions", "likely_parts", "estimate",
                   "needs_visit_when"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "follow_up_questions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sam_prompts": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 40}},
        "estimate": {"type": "object", "required": ["low", "high"],
                     "properties": {"low": {"type": "number", "minimum": 0}, "high": {"type": "number", "minimum": 0}}}
      }}},
    "parts": {"type": "array", "items": {
      "type": "object", "required": ["id", "name", "unit", "price"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "price": {"type": "number", "minimum": 0}}}}
  }
}
